{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/templates/pages/home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/templates/pages/:page(services|about|gallery|contact).html",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/templates/pages/home.html"
    },
    {
      "source": "/:page(services|about|gallery|contact)",
      "destination": "/templates/pages/:page.html"
    }
  ]
}
